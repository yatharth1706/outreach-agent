# Postgres (Neon in production)
DATABASE_URL=postgres://postgres@localhost:5434/email_scheduler

# Vercel AI Gateway key (not needed on Vercel, where OIDC is used automatically)
AI_GATEWAY_API_KEY=

# Google OAuth client (Web application). Redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: force the OAuth redirect origin (defaults to the request origin)
APP_URL=

# Secrets: generate each with `openssl rand -base64 32`
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
TOOL_APPROVAL_SECRET=
CRON_SECRET=

# Optional: comma-separated emails allowed to sign in (empty = anyone)
ALLOWED_EMAILS=

# Dev only: "log" prints emails instead of sending them through Gmail
EMAIL_TRANSPORT=

# Optional: use Gemini directly instead of the AI Gateway (takes priority when set)
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: override the model id for whichever provider is active
AGENT_MODEL=
